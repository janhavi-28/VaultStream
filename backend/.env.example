# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (required in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vaultstream?retryWrites=true&w=majority

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Initial Admin Credentials (used only on first seed) ───────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=Admin123!

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# e.g. https://vaultstream.vercel.app,https://www.yourdomain.com
CLIENT_URL=https://your-frontend.vercel.app
